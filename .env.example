# Copie para .env e troque os valores. Nunca commite o .env.
# A senha vai dentro de uma URL: use só letras, números, - e _.

# ---------------------------------------------------------------------------
# Banco da aplicação
# ---------------------------------------------------------------------------
POSTGRES_USER=enxoval
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=enxoval

# ---------------------------------------------------------------------------
# Portas expostas no host
# ---------------------------------------------------------------------------
API_PORT=8010
WEB_PORT=5180

# ---------------------------------------------------------------------------
# Painel admin e docs da API (ligar em dev, desligar em produção)
# ---------------------------------------------------------------------------
ADMIN_HABILITADO=true
DOCS_HABILITADO=true

# ---------------------------------------------------------------------------
# Keycloak — Identity Provider externo (keycloak-server)
#
# Em dev sem auth: deixe KEYCLOAK_HABILITADO=false
# Em dev com auth: suba o keycloak-server e mude para true
#
# URL interna (de dentro do container api → host): use host.docker.internal
# URL externa (acesso direto do navegador): use localhost:8080
# ---------------------------------------------------------------------------
KEYCLOAK_URL=http://host.docker.internal:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/enxoval
KEYCLOAK_REALM=enxoval
KEYCLOAK_CLIENT_ID=webapp
KEYCLOAK_HABILITADO=false
